# ============================================================
# Переменные окружения конвейера iPhone -> Yandex Cloud -> Obsidian
# Скопируйте в .env и заполните. .env НЕ коммитится (см. .gitignore).
# ============================================================

# --- Cloud Function (cloud-function/index.py) ---------------
# Задаются в настройках функции в консоли Yandex Cloud:

# Секретный токен webhook'а (придумайте длинную случайную строку,
# например: openssl rand -hex 16). Тот же токен вставляется в URL шортката.
INBOX_TOKEN=<случайная-строка-32-символа>

# Статический ключ сервисного аккаунта с ролью storage.editor на бакет
S3_KEY_ID=<YCAJE...>
S3_SECRET=<YCMn...>

# Имя бакета Object Storage (используется и функцией, и sync-скриптами)
BUCKET=<my-voice-inbox>

# --- Локальные sync-скрипты (sync/) -------------------------

# Имя бакета для sync-скриптов (то же значение, что BUCKET выше)
S3_BUCKET=<my-voice-inbox>
# Префикс для временных WAV при распознавании (по умолчанию stt-tmp/)
S3_PREFIX=stt-tmp/

# Путь к JSON-файлу со статическим ключом S3:
# {"access_key": {"key_id": "YCAJE..."}, "secret": "YCMn..."}
S3_SA_KEY_FILE=secrets/s3-sa-static.json

# API-ключ SpeechKit (сервисный аккаунт с ролью ai.speechkit.user)
YC_API_KEY=<AQVN...>
# Альтернатива YC_API_KEY: JSON-файл {"secret": "AQVN..."}
API_KEY_FILE=secrets/speechkit-apikey.json

# Путь к хранилищу Obsidian (обязательно для sync)
OBSIDIAN_VAULT=<C:\Users\you\Documents\Obsidian\my-vault>
# Папка заметок внутри хранилища (по умолчанию Meetings)
NOTES_DIR=Meetings
# Сдвиг часового пояса относительно UTC для времени в заметках (МСК = 3)
TZ_OFFSET_HOURS=3

# Необязательно: папка локальных записей (audio.mp4 + metadata.json).
# Пусто = обрабатывается только inbox из облака.
LOCAL_RECORDINGS=
